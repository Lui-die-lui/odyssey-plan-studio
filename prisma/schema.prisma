generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String  @id @default(cuid())
  provider       String?
  providerUserId String?
  email          String?
  name           String?
  image          String?
  role           UserRole @default(USER)
  aiBlocked      Boolean  @default(false)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  withdrawRequestedAt DateTime?
  hardDeleteAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  plan           Plan?
  aiDraftUsages AiDraftUsage[]
  aiRequestLogs  AiRequestLog[]

  @@unique([provider, providerUserId])
}

/// One plan per user (1:1). Contains up to five `PlanYear` rows (odyssey years 1–5).
model Plan {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Years with no path are an existing single plan and stay as they are.
  years PlanYear[]
  paths PlanPath[]
  preparations PlanPreparation[]
}

enum PlanPathKind {
  CONTINUE
  ALTERNATIVE
  UNBOUND
}

/// One of three futures explored side by side; a path owns its own five `PlanYear` rows.
model PlanPath {
  id     String       @id @default(cuid())
  planId String
  plan   Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  kind   PlanPathKind

  title             String
  overview          String   @default("")
  /// One line for the PDF map; the overview stays the full description.
  tagline           String   @default("")
  appeal            String   @default("")
  appealQuestionIds String[] @default([])
  requirements      String[] @default([])
  openQuestions     String[] @default([])
  /// Why no credential is suggested, such as practice mattering more here.
  credentialNote    String   @default("")
  /// User's comparison notes such as "attracted"; several paths may carry the same one.
  marks             String[] @default([])

  /// Self-ratings of the whole path; separate from yearly scores, null means not rated yet.
  resourcesScore  Int?
  interestScore   Int?
  confidenceScore Int?
  coherenceScore  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  years        PlanYear[]
  experiments  PlanPathExperiment[]
  preparations PlanPreparation[]

  @@unique([planId, kind])
  @@index([planId])
}

/// Something to study, practise or check before a path; no path means it helps several.
/// Source links and requirement status come from the code catalog through `catalogId`.
model PlanPreparation {
  id     String    @id @default(cuid())
  planId String
  plan   Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  pathId String?
  path   PlanPath? @relation(fields: [pathId], references: [id], onDelete: Cascade)

  position            Int
  catalogId           String?
  title               String
  kind                String
  priority            String
  reason              String
  /// One line for the PDF map: what the study is for.
  brief               String   @default("")
  basis               String
  evidenceQuestionIds String[] @default([])
  checkpoint          String
  conditions          String   @default("")
  alternative         String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([pathId])
}

/// A small action that tries part of a path before any big decision.
model PlanPathExperiment {
  id     String   @id @default(cuid())
  pathId String
  path   PlanPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  position Int
  action   String
  learning String
  nextUp   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pathId, position])
}

/// Single tab/year slot: odyssey year index 1–5 (not calendar year).
model PlanYear {
  id        String @id @default(cuid())
  planId    String
  plan      Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  pathId    String?
  path      PlanPath? @relation(fields: [pathId], references: [id], onDelete: Cascade)

  yearIndex Int

  /// Optional memo / summary for the year.
  note String?

  /// Self-ratings 1–5; null means not rated yet, which differs from a rating of 1.
  resourcesScore  Int?
  interestScore   Int?
  confidenceScore Int?
  coherenceScore  Int?

  /// Score keys saved before self-rating existed. Their author cannot be determined,
  /// so they stay flagged until the user changes or confirms them.
  unverifiedScoreKeys String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals      PlanYearGoal[]
  keywords   PlanYearKeyword[]
  aiGuidance PlanYearAiGuidance?

  @@unique([planId, pathId, yearIndex])
  @@index([planId])
  @@index([pathId])
}

/// Ordered goal line items for a plan year (max length enforced in app layer).
model PlanYearGoal {
  id         String   @id @default(cuid())
  planYearId String
  planYear   PlanYear @relation(fields: [planYearId], references: [id], onDelete: Cascade)

  position Int
  text     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planYearId, position])
  @@index([planYearId])
}

/// Ordered keywords for a plan year.
model PlanYearKeyword {
  id         String   @id @default(cuid())
  planYearId String
  planYear   PlanYear @relation(fields: [planYearId], references: [id], onDelete: Cascade)

  position Int
  text     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planYearId, position])
  @@index([planYearId])
}

/// Explanation kept from AI generation; absent for manual plans and plans saved earlier.
model PlanYearAiGuidance {
  id         String   @id @default(cuid())
  planYearId String   @unique
  planYear   PlanYear @relation(fields: [planYearId], references: [id], onDelete: Cascade)

  /// Generated goal and actions, compared with current goals to detect edits.
  sourceGoalTexts     String[]
  checkpoint          String
  rationale           String
  evidenceQuestionIds String[]
  pivotCondition      String
  /// Short forms for the PDF map, valid only while the generated goals are unedited.
  briefGoal           String   @default("")
  briefAction         String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiDraftUsage {
  id String @id @default(cuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** "YYYY-MM" (서버 기준) */
  monthKey String

  /** 월간 AI 초안 생성 누적 횟수 */
  usedCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, monthKey])
  @@index([userId, monthKey])
}

model AiRequestLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress     String?
  requestType   String
  success       Boolean
  blockedReason String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([requestType, createdAt])
  @@index([userId, createdAt])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
